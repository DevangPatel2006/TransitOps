# TransitOps Frontend Environment Configuration
#
# Local development (when using Vite proxy, this can default to /api/v1):
# VITE_API_URL=http://localhost:3000/api/v1
#
# Production deployment on Vercel:
# Set this to your Render backend service URL including /api/v1:
VITE_API_URL=https://transitops-backend.onrender.com/api/v1
