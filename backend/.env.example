# ==================================================
# TransitOps Backend Environment Variables (Production & Development)
# ==================================================

# Database Connection (Neon PostgreSQL with connection pooling & SSL)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.region.aws.neon.tech/neondb?sslmode=require"

# JWT Secret (Strong random secret for signing and verifying tokens; min 32 chars)
JWT_SECRET="generate-a-strong-secret-key-for-production"

# Allowed Frontend Origins for CORS (single URL or comma-separated list)
# Local: http://localhost:5173
# Production: https://transitops.vercel.app
FRONTEND_URL="https://transitops.vercel.app,http://localhost:5173"

# Express Server Port (Render sets PORT dynamically; fallback is 3000)
PORT=3000

# Node Environment ('production' for live deployments, 'development' for local)
NODE_ENV="production"

# Persistent Cloud Storage for Vehicle Documents (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# SMTP Settings for Driver License Expiry Email Reminders
SMTP_HOST="smtp.mailtrap.io"
SMTP_PORT=2525
SMTP_USER="your_smtp_username"
SMTP_PASS="your_smtp_password"
SMTP_FROM="TransitOps Safety Alerts <no-reply@transitops.com>"

# Comma-separated list of safety / operations admin emails to receive alerts
ADMIN_EMAILS="admin@transitops.com,safety@transitops.com"

# Internal Cron Setting (set to 'true' only if running internal node-cron instead of Render Cron Job)
ENABLE_INTERNAL_CRON="false"
